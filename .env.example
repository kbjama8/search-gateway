# Search Gateway — environment variables
#
# Copy to `.env` (or export in your shell / systemd EnvironmentFile) and edit.
# Everything has a sensible default; only the secret-bearing variables need
# real values. Secrets must never be committed — `.gitignore` blocks `*.env`.

# --- infrastructure ---
SEARXNG_BASE=http://127.0.0.1:8888
SEARCH_GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
GITHUB_TOKEN=

# --- search behaviour ---
SEARCH_GATEWAY_MAILTO=kaichen.research@proton.me
SEARCH_GATEWAY_TIMEOUT=50
SEARCH_GATEWAY_SOURCE_TIMEOUT=18

# --- retry ---
SEARCH_GATEWAY_RETRY_COUNT=1
SEARCH_GATEWAY_RETRY_BACKOFF=1.5

# --- rate limiting (cookie-logged sources) ---
SEARCH_GATEWAY_RATE_LIMIT=2.5

# --- fusion / re-rank / diversity ---
SEARCH_GATEWAY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SEARCH_GATEWAY_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEARCH_GATEWAY_EMBED_MODEL_CJK=BAAI/bge-m3
SEARCH_GATEWAY_CJK_SHARE_THRESHOLD=0.25
SEMANTIC_RERANK=1
SEARCH_GATEWAY_RERANK_CANDIDATES=30
SEARCH_GATEWAY_MMR=1
SEARCH_GATEWAY_MMR_LAMBDA=0.75
SEARCH_GATEWAY_EMBEDDING_DEDUP=1
SEARCH_GATEWAY_WEIGHTED_RRF=1
SEARCH_GATEWAY_FRESHNESS=1

# --- pinned model revisions (empty = unpinned) ---
SEARCH_GATEWAY_RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
SEARCH_GATEWAY_EMBED_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
SEARCH_GATEWAY_EMBED_CJK_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# --- inference backend (onnx_int8 = ~2x faster re-rank; needs `pip install '.[onnx]'`) ---
SEARCH_GATEWAY_INFERENCE_BACKEND=torch
SEARCH_GATEWAY_RERANK_ONNX_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
SEARCH_GATEWAY_RERANK_ONNX_REVISION=6f5ff65298512715a1e669753bc754d2bc8f367b

# --- two-tier / opencli parallelism ---
SEARCH_GATEWAY_TWO_TIER=1
SEARCH_GATEWAY_OPENCLI_PROFILES=1

# --- cache ---
SEARCH_GATEWAY_CACHE_TTL=3600
SEARCH_GATEWAY_SOURCE_CACHE_TTL=900

# --- LLM / answer synthesis ---
SEARCH_GATEWAY_QUERY_EXPANSION=1
SEARCH_GATEWAY_LLM=1
SEARCH_GATEWAY_LLM_MODEL=deepseek-v4-flash
SEARCH_GATEWAY_LLM_TIMEOUT=60
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- auth files (paths, not inline secrets) ---
TWITTER_AUTH_FILE=~/.agent-reach/twitter-auth.env
DEEPSEEK_AUTH_FILE=~/.agent-reach/deepseek.env

# --- observability / serving ---
SEARCH_GATEWAY_LOG_FMT=text
SEARCH_GATEWAY_LOG_LEVEL=INFO
SEARCH_GATEWAY_HOST=127.0.0.1
SEARCH_GATEWAY_PORT=8765

# --- ledger health ---
SEARCH_GATEWAY_LEDGER_DIR=~/research_runs
