# Kortex Search — environment variables
#
# Copy to `.env` (or export in your shell / systemd EnvironmentFile) and edit.
# Everything has a sensible default; only the secret-bearing variables need
# real values. Secrets must never be committed — `.gitignore` blocks `*.env`.

# --- infrastructure ---
SEARXNG_BASE=http://127.0.0.1:8888
KORTEX_SEARCH_REDIS_URL=redis://127.0.0.1:6379/0
# B6 hardening: after `redis-cli CONFIG SET requirepass <pw>`, use:
# KORTEX_SEARCH_REDIS_URL=redis://:<pw>@127.0.0.1:6379/0
# Required for the http/sse transports (401 without it):
KORTEX_SEARCH_HTTP_TOKEN=
# Per-source daily query budget (0 = unlimited):
KORTEX_SEARCH_DAILY_QUERY_LIMIT=300
GITHUB_TOKEN=

# --- search behaviour ---
KORTEX_SEARCH_MAILTO=kaichen.research@proton.me
KORTEX_SEARCH_TIMEOUT=50
KORTEX_SEARCH_SOURCE_TIMEOUT=18

# --- retry ---
KORTEX_SEARCH_RETRY_COUNT=1
KORTEX_SEARCH_RETRY_BACKOFF=1.5

# --- rate limiting (cookie-logged sources) ---
KORTEX_SEARCH_RATE_LIMIT=2.5

# --- fusion / re-rank / diversity ---
KORTEX_SEARCH_RERANK_MODEL=BAAI/bge-reranker-v2-m3
KORTEX_SEARCH_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KORTEX_SEARCH_EMBED_MODEL_CJK=BAAI/bge-m3
KORTEX_SEARCH_CJK_SHARE_THRESHOLD=0.25
KORTEX_SEARCH_SEMANTIC_RERANK=1
# (legacy unprefixed SEMANTIC_RERANK still honored)
KORTEX_SEARCH_RERANK_CANDIDATES=30
KORTEX_SEARCH_MMR=1
KORTEX_SEARCH_MMR_LAMBDA=0.75
KORTEX_SEARCH_EMBEDDING_DEDUP=1
KORTEX_SEARCH_WEIGHTED_RRF=1
KORTEX_SEARCH_FRESHNESS=1

# --- pinned model revisions (empty = unpinned) ---
KORTEX_SEARCH_RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
KORTEX_SEARCH_EMBED_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
KORTEX_SEARCH_EMBED_CJK_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# --- inference backend (onnx_int8 default = ~2x faster re-rank than torch) ---
KORTEX_SEARCH_INFERENCE_BACKEND=onnx_int8
KORTEX_SEARCH_RERANK_ONNX_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
KORTEX_SEARCH_RERANK_ONNX_REVISION=6f5ff65298512715a1e669753bc754d2bc8f367b

# --- two-tier / opencli parallelism ---
KORTEX_SEARCH_TWO_TIER=1
KORTEX_SEARCH_OPENCLI_PROFILES=1

# --- cache ---
KORTEX_SEARCH_CACHE_TTL=3600
KORTEX_SEARCH_SOURCE_CACHE_TTL=900

# --- LLM / answer synthesis ---
KORTEX_SEARCH_QUERY_EXPANSION=1
KORTEX_SEARCH_LLM=1
KORTEX_SEARCH_LLM_MODEL=deepseek-v4-flash
KORTEX_SEARCH_LLM_TIMEOUT=60
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- auth files (paths, not inline secrets) ---
# v0.4.1+: secrets live in the per-persona vault (~/.agent-reach/profiles/<persona>/,
# 0600). Legacy flat paths were removed in 0.4.3 (D7.3) — migrate first on any
# machine still carrying them (`kortex-search vault migrate`).
KORTEX_SEARCH_PERSONA=kaiser
KORTEX_SEARCH_VAULT_DIR=~/.agent-reach/profiles
# systemd $CREDENTIALS_DIRECTORY bridge (LoadCredential=) — secrets arrive as
# files, never env vars. Empty = bridge off.
KORTEX_SEARCH_CREDENTIALS_DIR=
TWITTER_AUTH_FILE=~/.agent-reach/profiles/kaiser/twitter.env
DEEPSEEK_AUTH_FILE=~/.agent-reach/profiles/kaiser/deepseek.env

# --- observability / serving ---
KORTEX_SEARCH_LOG_FMT=text
KORTEX_SEARCH_LOG_LEVEL=INFO
KORTEX_SEARCH_HOST=127.0.0.1
KORTEX_SEARCH_PORT=8765

# --- ledger health ---
KORTEX_SEARCH_LEDGER_DIR=~/research_runs
# --- B6' (2026-08-21) knobs ---
# Adaptive per-source timeout: min(p95 x factor, cap); floor guards slow-but-healthy
KORTEX_SEARCH_ADAPTIVE_TIMEOUT=1
KORTEX_SEARCH_ADAPTIVE_TIMEOUT_FACTOR=1.5
KORTEX_SEARCH_ADAPTIVE_TIMEOUT_MIN=3.0
KORTEX_SEARCH_ADAPTIVE_TIMEOUT_MAX=25.0
# Negative caching for failed sources (seconds)
KORTEX_SEARCH_NEGATIVE_CACHE_TTL=60
# Latency reservoir for p50/p95
KORTEX_SEARCH_STATS_RESERVOIR=60
# Query-rewrite gating: expand only when base results < gate
KORTEX_SEARCH_EXPANSION_GATE=6
# Per-category MMR lambda (relevance vs diversity)
KORTEX_SEARCH_MMR_LAMBDA_GENERAL=0.75
KORTEX_SEARCH_MMR_LAMBDA_NEWS=0.7
KORTEX_SEARCH_MMR_LAMBDA_SCIENCE=0.8
KORTEX_SEARCH_MMR_LAMBDA_SOCIAL=0.7

# --- v0.4 extraction layer (Project Gatekeeper) ---
# Browser budget: concurrent browser ops (default 1 = old single-bridge behavior)
KORTEX_SEARCH_BROWSER_BUDGET=1
# Rate-limit jitter (± fraction) — fixed intervals are themselves a fingerprint
KORTEX_SEARCH_RATE_LIMIT_JITTER=0.3
# read_url stage order (jina → trafilatura → readability)
KORTEX_SEARCH_READ_URL_STAGES=jina,trafilatura,readability
# Block/challenge detection on CLI outputs (default on)
KORTEX_SEARCH_BLOCK_DETECTION=1
# Per-platform circuit breaker: stop querying after N profiles blocked, cooldown seconds
KORTEX_SEARCH_PLATFORM_BLOCK_LIMIT=3
KORTEX_SEARCH_PLATFORM_COOLDOWN_TTL=900

# --- stealth (experimental, default OFF) ---
KORTEX_SEARCH_STEALTH=0
KORTEX_SEARCH_STEALTH_PROFILE=
# curl_cffi TLS/JA3 impersonation for fingerprinted APIs (bilibili/zhihu/weibo)
KORTEX_SEARCH_IMPERSONATE=0

# --- proxy subsystem (default OFF; see docs/extraction/proxy-funding-guide.md) ---
KORTEX_SEARCH_PROXY_ENABLED=0
KORTEX_SEARCH_PROXY_PROTOCOL=http
KORTEX_SEARCH_PROXY_GATEWAY=
KORTEX_SEARCH_PROXY_USERNAME=
KORTEX_SEARCH_PROXY_PASSWORD=
KORTEX_SEARCH_PROXY_COUNTRY=
KORTEX_SEARCH_PROXY_STICKY_TTL=30m
KORTEX_SEARCH_PROXY_GEO_ALIGN=1

# --- CN tier (default OFF; bilibili wbi signing is always on) ---
KORTEX_SEARCH_CN_SOURCES=0
ZHIHU_COOKIE=
WEIBO_SUB=
KORTEX_SEARCH_BILIBILI_WBI=1

# --- containment (v0.4.1, Phase 7) ---
# L1 egress floor: private/link-local/metadata ranges blocked pre-nav AND
# post-redirect. Default ON by design (the containment floor, not a risky flag).
KORTEX_SEARCH_EGRESS_FLOOR=1
# Operator allowlist for the floor (comma-separated hostnames/IPs). The
# gateway's own loopback deps (SEARXNG_BASE/REDIS_URL) are always exempt.
KORTEX_SEARCH_FLOOR_EXEMPT=
# Block-event telemetry reservoir size (recent denials kept, 24h TTL)
KORTEX_SEARCH_BLOCK_RESERVOIR=120

# --- L2 forced-proxy (v0.4.2) ---
# Loopback CONNECT proxy in front of the anonymous browser tier (Camoufox);
# every target passes the floor, then chains through the residential tier if
# enabled. Anonymous engines only (D7.2).
KORTEX_SEARCH_EGRESS_PROXY=1

# --- L3 kernel filter (v0.4.2) ---
# nftables per-cgroup egress DROP rules (D7.1). Browser-tier ops refuse to
# launch without it: required (default) | permissive (explicit opt-out for
# sandboxed CI). Install: kortex-search harden --install --sudo
KORTEX_SEARCH_HARDEN=required
# auto-use sudo when loading the ruleset (root already: auto)
KORTEX_SEARCH_HARDEN_SUDO=0
